# MyMomentum Production Environment Variables
# 使用說明: 複製此檔案為 env.prod 並填入真實值

# Spring Profile (生產環境使用 prod)
SPRING_PROFILES_ACTIVE=prod

# 資料庫設定
DB_USERNAME=mymomentum
DB_PASSWORD=<YOUR_SECURE_DB_PASSWORD>

# JWT 安全設定 (使用 openssl rand -hex 32 產生 64 字元的安全密鑰)
JWT_SECRET=<YOUR_JWT_SECRET_64_CHARS>

# Google OAuth 設定
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>

# 前端 URL 設定
FRONTEND_URL=https://your-domain.com
